# Browser-facing port of the official Terraforming Mars server.
TM_PORT=8888
# This value must be reachable from the user's browser. Do not use the compose
# service name (http://tm:8888) here.
TM_PUBLIC_URL=http://localhost:8888

# MCP Streamable HTTP endpoint.
MCP_PORT=8765
# Optional. When set, clients must send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=

# Minimum spacing between TM API calls and minimum response delay for inputs.
MIN_RESPONSE_INTERVAL_MS=250
TM_REQUEST_TIMEOUT_MS=30000

# Docker image used to build the MCP service. Set to node:26-alpine3.23 when
# the mirror is unavailable.
NODE_IMAGE=ssw29qyeeou949jadc.xuanyuan.run/library/node:26-alpine3.23

# Optional. Point this at a local upstream checkout instead of the git URL.
# TM_BUILD_CONTEXT=./upstream
